# VulnGuard AI Backend Environment Configuration

# Service Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://vulnguard.buildwithaveeck.com"]

# NVD Threat Intel Settings
# Leave blank for keyless mode (5 req/30s), or provide your NIST NVD API key (50 req/30s)
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_CACHE_TTL_HOURS=12

# FIRST EPSS Settings
EPSS_BASE_URL=https://api.first.org/data/v1/epss
EPSS_CACHE_TTL_HOURS=24

# CISA KEV Settings
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_CACHE_TTL_HOURS=6

# Database Backend (Phase 2): 'sqlite' or 'dynamodb'
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=./vulnguard.db
DYNAMODB_TABLE_NAME=VulnGuardAssessments

# AWS & Amazon Bedrock Settings
AWS_REGION=us-east-1
# AWS credentials will be picked up from ~/.aws/credentials or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# If Bedrock is not available, the platform automatically returns a deterministic remediation analysis.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
USE_BEDROCK_MOCK=false
