# ==============================================================================
# VulnGuard AI — Global Environment Variables Template
# ==============================================================================

# Backend Service Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://vulnguard.buildwithaveeck.com"]

# Threat Intelligence: NIST NVD API 2.0
# Leave blank for keyless mode (5 req / 30s) or provide key (50 req / 30s)
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_CACHE_TTL_HOURS=12

# Threat Intelligence: FIRST.org EPSS
EPSS_BASE_URL=https://api.first.org/data/v1/epss
EPSS_CACHE_TTL_HOURS=24

# Threat Intelligence: CISA KEV
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_CACHE_TTL_HOURS=6

# Persistence Database: 'sqlite' or 'dynamodb'
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=./vulnguard.db
DYNAMODB_TABLE_NAME=vulnguard_assessments

# AWS & Amazon Bedrock Nova AI Settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
USE_BEDROCK_MOCK=false

# Frontend Configuration (Used during Vite build)
VITE_API_BASE_URL=http://localhost:8000
